import { Component } from 'svelte';

interface SpringParams {
    stiffness?: number;
    damping?: number;
    mass?: number;
    precision?: number;
}

interface BaseMorphOptions {
    element: HTMLElement;
    /** Ignored when `ease` is a spring, which settles on its own physics. */
    duration?: number;
    ease?: string | SpringParams;
    locale?: Intl.LocalesArgument;
    disabled?: boolean;
    respectReducedMotion?: boolean;
    onAnimationStart?: () => void;
    onAnimationComplete?: () => void;
}

interface TextMorphOptions extends BaseMorphOptions {
    debug?: boolean;
    scale?: boolean;
    /** Morph numeric words by place value. Off falls back to the character-level morph. */
    numbers?: boolean;
    /** Fraction digits for a numeric value. Ignored for strings. */
    decimals?: number;
    onAnimationCancel?: () => void;
}

interface TextMorphProps extends Omit<TextMorphOptions, "element"> {
    text: string;
    class?: string;
    style?: string;
    as?: string;
}
declare const TextMorph: Component<TextMorphProps>;

export { TextMorph, type TextMorphProps };
